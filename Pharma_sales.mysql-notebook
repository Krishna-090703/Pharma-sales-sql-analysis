                    "sql": "with monthly_sales as (\n    select DATE_FORMAT(sale_date, '%Y-%m') as months, category, sum(amount) as Totalsales\n    from dailysales\n    group by months,category )\n    select months , category , Totalsales, \n    lag(Totalsales) OVER (partition by category ORDER BY months) as prev_month_sales,\n    round((Totalsales - lag(Totalsales)Over(partition by category order by months))/ LAG(Totalsales) over(partition by category order by months)*100,2) as pct_change \n    from monthly_sales",
