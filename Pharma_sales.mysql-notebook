    "caption": "DB Notebook",
    "content": "\\about\nUse pharma_sales;\nselect * from dailysales;\nselect sum(amount) as Totalsales from dailysales;\nselect category, sum(amount) as Totalsales \nfrom dailysales \ngroup by category;\nselect medicine_name , sum(amount) as Totalsales \nfrom dailysales \ngroup by medicine_name \norder by Totalsales desc limit 1;\nselect date_format(sale_date, '%Y-%m') as month, category, sum(amount) as Totalsales \nfrom dailysales \ngroup by month, category\norder by month;\nwith monthly_sales as (\n    select DATE_FORMAT(sale_date, '%Y-%m') as months, category, sum(amount) as Totalsales\n    from dailysales\n    group by months,category )\n    select months , category , Totalsales, \n    lag(Totalsales) OVER (partition by category ORDER BY months) as prev_month_sales,\n    round((Totalsales - lag(Totalsales)Over(partition by category order by months))/ LAG(Totalsales) over(partition by category order by months)*100,2) as pct_change \n    from monthly_sales;\n\nselect sale_date, category, avg(amount) over(partition by category order by sale_date rows between 6 preceding and current row) as mov_avg\nfrom dailysales;\nselect DATE_FORMAT(sale_date, '%Y-%m')as months,category, avg(amount) as Avg\nfrom dailysales\ngroup by months,category;\n\nselect YEAR(sale_date) as years, sum(amount) as TotalSales, RANK() over(partition by category ORDER BY year(sale_date) DESC) as ranks\nfrom dailysales\nGROUP by years,category\nORDER BY ranks;\n\n",
